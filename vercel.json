{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/shop/regent/",
      "destination": "/shop/eyeglasses/",
      "permanent": true
    },
    {
      "source": "/shop/boulevard/",
      "destination": "/shop/eyeglasses/",
      "permanent": true
    },
    {
      "source": "/shop/arcade/",
      "destination": "/shop/eyeglasses/",
      "permanent": true
    },
    {
      "source": "/shop/meridian/",
      "destination": "/shop/eyeglasses/",
      "permanent": true
    },
    {
      "source": "/shop/solstice/",
      "destination": "/shop/sunglasses/",
      "permanent": true
    },
    {
      "source": "/shop/afterlight/",
      "destination": "/shop/sunglasses/",
      "permanent": true
    }
  ]
}
